# Copier en .env (ou lancer `uv run comptarex-admin init`, qui génère des valeurs au hasard)
SITE_LOGIN=c.moreau@fiduciaire-moreau.test
SITE_PASSWORD=changez-moi
# Jeton de l'API technique /api/* (en-tête X-Admin-Token). Vide : API fermée.
SITE_ADMIN_TOKEN=
# Clé de signature du cookie de session (garder la même pour que la session survive aux redémarrages)
SECRET_KEY=changez-moi
PORT=8042
# 127.0.0.1 en local ; 0.0.0.0 sur Railway
HOST=127.0.0.1
# Facultatif : autre emplacement de la base
# COMPTAREX_DB=/chemin/vers/comptarex.db
