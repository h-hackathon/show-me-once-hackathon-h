# SMO : copie en .env (jamais commité) et remplis. `uv run smo doctor` dit ce qui manque.

# H Company : platform.hcompany.ai/settings/api-keys
HAI_API_KEY=
HOLO_MODEL=holo3-1-35b-a3b        # lecture des captures, une à la fois ; holo4-27b si crédits
HOLO_SYNTH_MODEL=                 # synthèse en texte seul (vide = HOLO_MODEL)
SMO_AGENT_MODEL=                  # modèle de l'agent custom (vide = défaut H, holo4-27b)
SMO_REPLAY_AGENT=h/web-surfer-pro # agent qui refait la démo, guidé pas à pas

# Gladia : app.gladia.io > API Keys (coupon hackathon dans prep/ressources/Gladia)
GLADIA_API_KEY=

# Linkup : app.linkup.so (code promo dans prep/ressources/Linkup)
LINKUP_API_KEY=

# Devin : app.devin.ai > Settings > API (service user, token cog_...)
DEVIN_API_KEY=
DEVIN_ORG_ID=
DEVIN_REPO=                       # ex. owner/smo : le repo où Devin ouvre ses PR
DEVIN_MAX_ACU=10

# Logiciel cible : le site compta (docs/CONTRAT_SITE.md)
SITE_URL=                         # https://... en ligne, ou http://localhost:PORT
SITE_LOGIN=
SITE_PASSWORD=
SITE_DOSSIER=                     # dossier ouvert après la connexion, ex. 00417 ATELIER DORN SAS
SITE_ADMIN_TOKEN=

# Serveur SMO (Railway)
SMO_SERVER_URL=                   # https://xxx.up.railway.app
SMO_SERVER_TOKEN=                 # header X-SMO-Token ; obligatoire en ligne (16 caractères min.), sinon le serveur ne démarre pas
H_WEBHOOK_SECRET=                 # donné une seule fois par `uv run smo webhook`
SMO_AUTO_REPAIR=0                 # 1 : interface changée → Devin relancé tout seul
