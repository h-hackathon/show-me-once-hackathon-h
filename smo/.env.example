# SMO : réglages (jamais commités). Copier en .env, remplir ; `uv run smo doctor` dit ce qui manque.
# Sur Railway : les mêmes variables, dans l'onglet Variables du service SMO.

# --- Clés des API
HAI_API_KEY=        # platform.hcompany.ai/settings/api-keys
GLADIA_API_KEY=     # app.gladia.io > API Keys
LINKUP_API_KEY=     # app.linkup.so
DEVIN_API_KEY=      # Devin > Settings > Devin API > Service users (token cog_…)
DEVIN_ORG_ID=       # en haut de la même page (org-…)
DEVIN_REPO=         # owner/repo où Devin ouvre ses PR

# --- Agent web : le logiciel en ligne
SITE_URL=           # ex. https://show-me-once-prep-production.up.railway.app (Qonta)
# Les identifiants du site sont dans le vault H de l'utilisateur (un élément avec l'adresse du site) : SMO le
# retrouve par l'adresse, le rattache au navigateur de l'agent et le relit à chaque appel de tool. Rien ici.
H_VAULT_ID=         # facultatif : le vault où chercher (vide = tous ceux de l'organisation)
# localhost (développement) seulement : H ne rattache pas de vault à un navigateur local
SITE_LOGIN=
SITE_PASSWORD=

# --- Agent bureau : l'appli de bureau, sur le PC du live (relais) ou dans un environnement desktop configuré dans H
H_DESKTOP_BRIDGE=   # identifiant du relais du PC du live, affiché par scripts/desktop_bridge.sh (un UUID)
H_DESKTOP_ENV=      # sinon, identifiant d'un environnement desktop dans H ; prioritaire sur le relais
# (les deux vides = le bureau de la machine où tourne SMO, utile en local seulement)
# identifiants de l'appli (vide = ceux du site)
DESKTOP_LOGIN=
DESKTOP_PASSWORD=

# --- Serveur SMO en ligne (son propre projet Railway)
SMO_SERVER_URL=     # https://…up.railway.app
SMO_SERVER_TOKEN=   # 16 caractères min. ; mot de passe commun avec h-tools et la page ; obligatoire en ligne

# --- En local : clone d'h-tools, pour essayer un tool sans le déployer
H_TOOLS_DIR=        # ex. /Users/<toi>/h-tools

# --- Réglages facultatifs (absents = valeur par défaut)
# HOLO_MODEL=holo3-1-35b-a3b      lecture des captures
# HOLO_SYNTH_MODEL=               synthèse en texte seul (vide = HOLO_MODEL)
# SMO_AGENT_MODEL=                modèle de l'agent custom (vide = défaut H)
# SMO_REPLAY_AGENT=h/web-surfer-pro
# DEVIN_MAX_ACU=10                plafond de crédits Devin par session
# SMO_AUTO_REPAIR=0               1 : Devin relancé tout seul si l'interface change
# SMO_RUNS_DIR=runs               Railway : /data/runs, sur un volume
# SITE_ADMIN_TOKEN=               API technique du site, pour relire ce qui est enregistré
# SMO_TOOL_URL=                   repli si un tool n'a pas été annoncé (gabarit avec {name})
# SMO_WORKER_KINDS=               agents servis (défaut : web et desktop ; à restreindre si deux serveurs tournent)
# H_WEBHOOK_SECRET=               webhook H facultatif (`uv run smo webhook`) : sinon interrogation toutes les 5 s
