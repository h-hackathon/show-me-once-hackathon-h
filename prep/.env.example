# Copier ce fichier en .env (privé, jamais sur GitHub) puis remplir
HAI_API_KEY=hk-...            # ta clé H : platform.hcompany.ai/settings/api-keys
GLADIA_API_KEY=               # ta clé Gladia : app.gladia.io > API Keys
ODOO_URL=                     # adresse du tunnel (https://xxx.trycloudflare.com)
ODOO_LOGIN=                   # rempli par odoo/setup_odoo.sh
ODOO_PASSWORD=                # rempli par odoo/setup_odoo.sh
STRIPE_LOGIN=                 # e-mail du compte Stripe créé pour le hackathon (pas un compte perso)
STRIPE_PASSWORD=              # mot de passe de ce compte
STRIPE_SECRET_KEY=sk_test_... # clé sandbox (Dashboard > Développeurs > Clés API), pour créer les données de test
