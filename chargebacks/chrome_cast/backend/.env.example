# Gladia — https://app.gladia.io
GLADIA_API_KEY=
GLADIA_LANGUAGES=fr,en
GLADIA_SUMMARIZE=true

# H Company — https://portal.hcompany.ai (Agents API)
HAI_API_KEY=
HAI_BASE_URL=https://agp.eu.hcompany.ai/api/v2
HAI_DEFAULT_AGENT=h/web-surfer-flash
HAI_SKILL_NAMESPACE=
# Connexion aux sites dans le navigateur cloud H (voir README « Connecter l'agent à Stripe »)
HAI_VAULT_ID=
HAI_USE_DEFAULT_PROFILE=true
HAI_BROWSER_PROFILE_ID=

# Optionnel : protège les endpoints d'écriture (header X-ShowMeOnce-Key, à mettre aussi dans l'extension)
SHOWMEONCE_API_KEY=
# SHOWMEONCE_DATA_DIR=./data/recordings
