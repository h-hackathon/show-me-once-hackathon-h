{
  "manifest_version": 3,
  "name": "Show Me Once Recorder",
  "version": "0.1.0",
  "description": "Enregistre ton écran, tes clics et ta voix pour transformer une tâche en automatisation.",
  "permissions": ["tabs", "storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Show Me Once" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
