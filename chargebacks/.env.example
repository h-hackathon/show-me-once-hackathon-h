# Copier en .env (privé, jamais sur GitHub) puis remplir
HAI_API_KEY=hk-...               # platform.hcompany.ai/settings/api-keys
GLADIA_API_KEY=                  # app.gladia.io > API Keys

# Stripe — compte créé pour le hackathon, MODE TEST uniquement
STRIPE_SECRET_KEY=sk_test_...    # Dashboard > Développeurs > Clés API (sert à créer les litiges et à lire leurs statuts)

# Comptes de test que l'agent utilise pour se connecter (le code e-mail te sera demandé dans le terminal)
SHOPIFY_LOGIN=
SHOPIFY_PASSWORD=
STRIPE_PASSWORD=
OTP=0                            # 0 = pas de double authentification (pas d'outil de code)

# Vrais outils (comptes gratuits créés pour le hackathon)
SHOPIFY_ADMIN_URL=               # ex. https://admin.shopify.com/store/sportiva-demo
FRESHDESK_URL=                   # ex. https://sportiva.freshdesk.com

# Les 3 outils internes (site statique du dossier outils/, déployé sur Vercel)
OUTILS_URL=                      # ex. https://sportiva-outils.vercel.app

# Connexion de l'agent au Dashboard Stripe : remplir UNE des 2 options
# Option 1 : profil H par défaut, rempli avec `python -m som connexion`
HAI_USE_DEFAULT_PROFILE=
# Option 1 bis : profil navigateur H importé (zip)
HAI_BROWSER_PROFILE_ID=
HAI_VAULT_ID=
# Option 2 : l'agent se connecte et lit le code reçu dans une boîte dédiée (IMAP, mot de passe d'application)
STRIPE_LOGIN=
OTP_IMAP_HOST=                   # imap.gmail.com
OTP_IMAP_USER=
OTP_IMAP_PASSWORD=

# Modèles
HAI_AGENT=h/web-surfer-pro
HOLO_MODEL=holo3-1-35b-a3b       # holo4-35b-a3b / holo4-27b si les crédits le permettent
