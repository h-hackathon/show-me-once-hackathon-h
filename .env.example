# Copier en .env (privé, jamais sur GitHub) puis remplir
HAI_API_KEY=hk-...               # platform.hcompany.ai/settings/api-keys
GLADIA_API_KEY=                  # app.gladia.io > API Keys

# Databricks Free Edition (compte créé pour le hackathon)
DATABRICKS_URL=                  # https://dbc-xxxx.cloud.databricks.com

# Connexion de l'agent à Databricks : remplir UNE des 2 options
# Option 1 (recommandée) : profil navigateur H déjà connecté (platform.hcompany.ai)
HAI_BROWSER_PROFILE_ID=
HAI_VAULT_ID=
# Option 2 : l'agent se connecte par e-mail et lit le code reçu dans une boîte dédiée (IMAP, mot de passe d'application)
DATABRICKS_EMAIL=
OTP_IMAP_HOST=                   # imap.gmail.com
OTP_IMAP_USER=
OTP_IMAP_PASSWORD=

# Google Sheet (voir sheets/dashboard.gs)
SHEET_URL=                       # lien du Sheet, partagé « tous les utilisateurs disposant du lien » en éditeur
SHEET_WEBAPP_URL=                # URL /exec de l'Apps Script déployé (pour notre vérificateur)
SHEET_TOKEN=                     # même valeur que TOKEN dans le script

# Modèles
HAI_AGENT=h/web-surfer-pro
HOLO_MODEL=holo3-1-35b-a3b       # holo4-35b-a3b / holo4-27b si les crédits le permettent
