# En local seulement (copier en .env, jamais commité) : un compte de TEST du logiciel.
# En production, ces valeurs viennent du vault H, lues par SMO à chaque appel ; chez Devin, de ses secrets de session.
SITE_URL=
SITE_USERNAME=
SITE_PASSWORD=
SITE_TOTP=          # un code du moment, si le site a une double authentification
SMO_SERVER_TOKEN=   # mot de passe commun avec SMO (vide en local = tool ouvert)
