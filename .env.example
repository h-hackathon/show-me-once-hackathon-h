# Copier en .env (privé, jamais sur GitHub) puis remplir
HAI_API_KEY=hk-...               # platform.hcompany.ai/settings/api-keys
GLADIA_API_KEY=                  # app.gladia.io > API Keys

# Odoo
ODOO_URL=                        # adresse publique pour l'agent : https://xxx.trycloudflare.com
ODOO_LOCAL_URL=http://localhost:8069   # adresse locale, utilisée par notre vérificateur
ODOO_DB=hackathon
ODOO_LOGIN=                      # rempli par odoo/setup_odoo.sh
ODOO_PASSWORD=                   # rempli par odoo/setup_odoo.sh

# Factures montrées à l'agent : URL publique des PNG (tunnel-files). Vide = texte de la facture dans la consigne.
INVOICE_BASE_URL=

# Modèles
HAI_AGENT=h/web-surfer-pro
HOLO_MODEL=holo3-1-35b-a3b       # holo4-35b-a3b / holo4-27b si les crédits le permettent
